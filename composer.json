{
    "name": "kjgcoop/vikunja-to-md",
    "description": "Export a Vikunja kanban project to Markdown",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.1",
        "kjgcoop/vikunja-api": "dev-claude/wonderful-shannon-bczbxo",
        "league/html-to-markdown": "^5.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/kjgcoop/vikunja-api" }
    ],
    "autoload": {
        "psr-4": { "Kjgcoop\\VikunjaToMd\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Kjgcoop\\VikunjaToMd\\Tests\\": "tests/" }
    },
    "bin": ["bin/export.php"],
    "scripts": {
        "test": "phpunit --testsuite Unit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
